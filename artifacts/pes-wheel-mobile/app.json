{
  "expo": {
    "name": "PES WHEEL",
    "slug": "peswheel",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon_2.png",
    "scheme": "peswheel",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon_2.png",
      "resizeMode": "contain",
      "backgroundColor": "#09091d"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.peswheel.app"
    },
    "android": {
      "package": "com.peswheel.app"
    },
    "web": {
      "favicon": "./assets/images/icon_2.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "d8d12667-8616-428d-bf1b-8a1a28228186"
      }
    }
  }
}